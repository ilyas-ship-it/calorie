{
  "expo": {
    "name": "Calorie AI",
    "slug": "calorie",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calorie",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.calorie.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F5EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ai.calorie.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F3F7F4"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Calorie AI to access photos for plate and label logging.",
          "cameraPermission": "Allow Calorie AI to use the camera to capture meals and labels."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
