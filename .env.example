# Copy to `.env` for local overrides. Never commit real secrets.
# Expo only exposes EXPO_PUBLIC_* to the client bundle.

# Vision (plate detection) — future cloud / edge API
EXPO_PUBLIC_VISION_API_URL=
EXPO_PUBLIC_VISION_API_KEY=

# OCR (nutrition labels)
EXPO_PUBLIC_OCR_API_URL=
EXPO_PUBLIC_OCR_API_KEY=

# Nutrition database (USDA / Open Food Facts / licensed)
EXPO_PUBLIC_NUTRITION_DB_URL=
EXPO_PUBLIC_NUTRITION_DB_KEY=

# Auth provider base URL (Supabase / Clerk / custom)
EXPO_PUBLIC_AUTH_URL=

# Soft premium feature flag (billing stub)
EXPO_PUBLIC_FEATURE_PREMIUM=false
